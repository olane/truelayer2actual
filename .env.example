# TrueLayer — from console.truelayer.com
# Use sandbox- prefix client IDs for testing
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=http://localhost:3000/callback

# Actual Budget
ACTUAL_SERVER_URL=http://your-nas:5006
ACTUAL_PASSWORD=
ACTUAL_SYNC_ID=               # default budget sync id (optional if you add budgets during setup)
ACTUAL_ENCRYPTION_PASSWORD=   # optional — only if E2E encryption is enabled

# If Actual is served over HTTPS with a self-signed cert, trust just that CA.
# Never use NODE_TLS_REJECT_UNAUTHORIZED=0: it disables certificate validation
# for every outbound request, including TrueLayer auth and data calls.
# NODE_EXTRA_CA_CERTS=/path/to/actual-ca.pem

# Sync behaviour
SYNC_DAYS_LOOKBACK=7
SYNC_INTERVAL_HOURS=0   # 0 = one-shot (external cron); >0 = built-in loop (e.g. 6)
SETUP_PORT=3000

# Always-on dashboard (npm run serve)
PORT=3000                              # falls back to SETUP_PORT, then 3000
DASHBOARD_URL=http://localhost:3000
REAUTH_WARN_DAYS=14                    # notify when consent expires within this many days

# Notifications (both optional)
NTFY_URL=                              # full topic URL, e.g. https://ntfy.sh/my-topic
HA_WEBHOOK_URL=                        # Home Assistant webhook URL
